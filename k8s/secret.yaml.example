# TEMPLATE ONLY. Do not commit real credentials.
# For production, prefer Azure Key Vault + Workload Identity integration.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-connection
  namespace: production
type: Opaque
stringData:
  DB_HOST: "REPLACE-WITH-postgres_server_fqdn"
  DB_NAME: "appdb"
  DB_USERNAME: "pgadminuser"
  DB_PASSWORD: "RETRIEVE-SECURELY-DO-NOT-COMMIT"
  DB_PORT: "5432"
